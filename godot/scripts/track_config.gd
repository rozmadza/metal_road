extends Resource
class_name TrackConfig
## Data for a closed-loop track.
##
## The centerline is a list of points that form a closed loop (the last point
## connects back to the first). Inner and outer boundaries are generated by
## offsetting the centerline by `track_width / 2`.
##
## Edit `centerline` in the Inspector to reshape the track, or duplicate this
## resource to author a new track without writing code.

@export_group("Geometry")
@export_range(10.0, 1000.0, 1.0) var track_width: float = 210.0
## Visual racing lanes. The game keeps this equal to the participant count.
@export_range(1, 12, 1) var lane_count: int = 6
@export var centerline: PackedVector2Array = PackedVector2Array([
	Vector2(200, 150),
	Vector2(600, 150),
	Vector2(850, 200),
	Vector2(1080, 280),
	Vector2(1320, 260),
	Vector2(1550, 340),
	Vector2(1720, 500),
	Vector2(1770, 690),
	Vector2(1680, 860),
	Vector2(1740, 1040),
	Vector2(1640, 1190),
	Vector2(1450, 1260),
	Vector2(1240, 1220),
	Vector2(1050, 1150),
	Vector2(860, 1210),
	Vector2(650, 1300),
	Vector2(430, 1270),
	Vector2(230, 1190),
	Vector2(100, 1040),
	Vector2(90, 860),
	Vector2(180, 700),
	Vector2(120, 530),
	Vector2(-250, 550),
	Vector2(-250, 150),
])

@export_group("Waypoints")
## Radius around a centerline point at which AI advances to the next waypoint.
@export_range(0.0, 500.0, 1.0) var waypoint_radius: float = 32.0

@export_group("Looks")
@export var biome_id: StringName = &"industrial"
@export var biome_name: String = "INDUSTRIAL STEELWORKS"
@export_multiline var biome_description: String = "Сухой индустриальный асфальт и тяжёлые ограждения."
@export var surface_color: Color = Color(0.392, 0.392, 0.392)
@export var surface_tint: Color = Color(0.42, 0.46, 0.49, 1.0)
@export_range(0.0, 1.0, 0.05) var surface_detail: float = 0.38
@export var edge_color: Color = Color(0.588, 0.588, 0.588)
@export var centerline_color: Color = Color(1.0, 1.0, 0.0)
@export var finish_line_color: Color = Color(1.0, 0.0, 0.0)
@export var waypoint_color: Color = Color(0.0, 0.0, 1.0)
@export var background_color: Color = Color(0.078431, 0.078431, 0.078431)
@export var background_modulate: Color = Color(0.32, 0.34, 0.36, 1.0)

@export_group("Biome gameplay")
@export_range(0.1, 1.0, 0.01) var road_traction: float = 1.0
@export_range(0.1, 1.0, 0.01) var road_steering: float = 1.0
@export_range(0.1, 1.0, 0.01) var offroad_traction: float = 0.62
@export_range(0.1, 1.0, 0.01) var offroad_steering: float = 0.72
@export_range(0, 2, 1) var decor_style: int = 0
@export_range(0, 10, 1) var hazard_count: int = 2
@export var bonus_hotspots: PackedFloat32Array = PackedFloat32Array()
@export var hazard_profile: StringName = &"industrial"

@export_group("Weather")
@export var weather_type: StringName = &"clear"
@export_range(0.0, 1.0, 0.05) var storm_strength: float = 0.0
@export_range(4.0, 120.0, 1.0) var storm_interval: float = 32.0
@export_range(2.0, 60.0, 1.0) var storm_duration: float = 12.0
@export_range(0.5, 1.0, 0.01) var storm_traction: float = 0.82


@export_group("Assets")
## Optional tiled texture for the track surface (drawn as a ribbon).
@export var surface_texture: Texture2D
## Optional tiled texture for the area around the track.
@export var background_texture: Texture2D

@export_group("Race")
@export var combat_enabled: bool = true
@export_range(1, 20) var laps: int = 3
@export_range(0.5, 1.0) var minimum_lap_fraction: float = 0.85
@export_range(1.0, 100.0) var progress_step_tolerance: float = 40.0
@export_range(0.0, 30.0) var progress_edge_margin: float = 8.0
